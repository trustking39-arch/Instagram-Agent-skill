# Am einfachsten: `content-crew setup` ausführen, der Assistent füllt diese Datei.
# .env wird NICHT ins Git-Repo hochgeladen.

# --- Twilio (SMS + Sprachanrufe) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
OWNER_PHONE_NUMBER=

# --- Pexels (kostenlose Hintergrundvideos) ---
PEXELS_API_KEY=

# --- YouTube ---
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json

# --- Instagram (wird von `content-crew auth-instagram` ausgefüllt) ---
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- TikTok (Tokens füllt `content-crew auth-tiktok` aus) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8788/callback/
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- Jarvis / OpenJarvis ---
JARVIS_API_KEY=none
