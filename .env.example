# Kopiere diese Datei nach .env und trage deine Zugangsdaten ein.
# .env wird NICHT ins Git-Repo hochgeladen.

# --- Twilio (SMS + Sprachanrufe) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # deine Twilio-Nummer, z. B. +4930...
OWNER_PHONE_NUMBER=           # DEINE Handynummer, z. B. +49170...

# --- YouTube ---
YOUTUBE_API_KEY=              # für Trend-Suche
YOUTUBE_CLIENT_SECRET_FILE=secrets/youtube_client_secret.json   # für Uploads (OAuth)

# --- Instagram (Business/Creator-Konto über Meta Graph API) ---
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# --- TikTok (Content Posting API) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# --- Jarvis / OpenJarvis ---
JARVIS_API_KEY=none
